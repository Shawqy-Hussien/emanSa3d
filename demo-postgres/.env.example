NODE_ENV=development
PORT=3000
COOKIE_SECURE=false
DATABASE_URL=postgresql://localhost:5432/pharmacy_demo

# Import only business data into a fresh PostgreSQL database.
SQLITE_SOURCE_PATH=../data/pharmacy.sqlite
DEMO_BACKUP_PATH=./local/pharmacy-source-backup.sqlite

# Tests require a separate, local disposable database whose name ends in _test.
TEST_DATABASE_URL=postgresql://localhost:5432/pharmacy_demo_test
ALLOW_TEST_DATABASE_RESET=NO
